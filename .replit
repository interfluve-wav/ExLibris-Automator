modules = ["python-3.12", "web", "bash", "nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["gitFull", "glibcLocales", "playwright-driver", "rapidfuzz-cpp", "taskflow"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "VNC Desktop"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DISPLAY=:99 FLASK_HOST=0.0.0.0 NO_OPEN_BROWSER=1 python esp_gui_web.py --standalone --port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "VNC Desktop"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start_desktop.sh"

[workflows.workflow.metadata]
outputType = "vnc"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "FLASK_HOST=0.0.0.0 NO_OPEN_BROWSER=1 python esp_gui_web.py --standalone --port 5000"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
